---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';
import { getSite } from '../utils/consts';

type Language = 'en' | 'fr';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const site = await getSite();
const spaces = (await getCollection('privateDiningSpaces'))
	.filter((space) => space.id.startsWith(`${lang}/`))
	.sort((a, b) => a.id.localeCompare(b.id));

const copy = {
	en: {
		title: 'Private Dining',
		eyebrow: 'Gather together',
		description: 'Discover our private spaces for a more intimate dining experience.',
		capacity: (count: number) => `Seats up to ${count} guests`,
		empty: 'Details about our private dining spaces are coming soon.',
	},
	fr: {
		title: 'Repas privés',
		eyebrow: 'À partager',
		description: 'Découvrez nos espaces privés pour un repas plus intime.',
		capacity: (count: number) => `Jusqu’à ${count} personnes`,
		empty: 'Les détails de nos espaces privés seront bientôt disponibles.',
	},
};

const text = copy[lang];
---

<PageLayout title={`${text.title} · ${site.title}`} description={text.description}>
	<section class="content-shell space-y-10 py-12">
		<header class="max-w-3xl space-y-3">
			<p class="eyebrow m-0">{text.eyebrow}</p>
			<h1 class="page-title">{text.title}</h1>
			<p class="m-0 text-muted">{text.description}</p>
		</header>

		{spaces.length === 0 ? (
			<p class="text-muted">{text.empty}</p>
		) : (
			<div class="space-y-10">
				{spaces.map((space, index) => (
					<article
						class={`border-b border-border pb-10 last:border-b-0 ${
							space.data.image ? 'grid gap-8 lg:grid-cols-2 lg:items-center lg:gap-16' : 'max-w-3xl'
						}`}
					>
						{space.data.image && (
							<figure class={`m-0 overflow-hidden rounded-2xl ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
								<Image
									src={space.data.image}
									alt={space.data.name}
									class="aspect-[4/3] w-full object-cover lg:aspect-[5/4]"
									width={1200}
									height={960}
								/>
							</figure>
						)}
						<div class="flex flex-col justify-center gap-4 py-2 lg:py-10">
							<div>
								<h2 class="section-title">{space.data.name}</h2>
								<p class="mt-3 mb-0 text-sm font-medium uppercase tracking-wide text-muted">
									{text.capacity(space.data.capacity)}
								</p>
							</div>
							{space.data.description && <p class="m-0 max-w-prose text-lg text-muted">{space.data.description}</p>}
						</div>
					</article>
				))}
			</div>
		)}
	</section>
</PageLayout>
