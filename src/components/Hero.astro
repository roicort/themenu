---
interface Action {
	label: string;
	href: string;
}

interface Props {
	eyebrow?: string;
	title: string;
	displayWord?: string;
	description?: string;
	actions?: Action[];
}

import { withBase } from '../utils/slugify';

const { eyebrow, title, displayWord, description, actions = [] } = Astro.props;
const displayWordIndex = displayWord ? title.indexOf(displayWord) : -1;
---

<section class="content-shell flex items-center">
	<div class="grid gap-4 max-w-3xl">
		{eyebrow && <p class="eyebrow">{eyebrow}</p>}
		<h1 class="page-title">
			{displayWordIndex >= 0 && displayWord ? (
				<>
					{title.slice(0, displayWordIndex)}
					<span class="font-display">{displayWord}</span>
					{title.slice(displayWordIndex + displayWord.length)}
				</>
			) : title}
		</h1>
		{description && <p class="text-muted text-base md:text-lg max-w-2xl m-0">{description}</p>}
		{actions.length > 0 && (
			<div class="flex flex-wrap gap-3 mt-3">
				{actions.map((action) => (
					<a class="button primary" href={withBase(action.href)}>
						{action.label}
					</a>
				))}
			</div>
		)}
	</div>
</section>

<style>
	.content-shell {
		min-height: calc(100vh - var(--header-height));
	}

	@media (max-width: 1023px) {
		.content-shell {
			min-height: calc(100vh - var(--header-height));
		}
	}
</style>
