---
import { getSite } from "../utils/consts";
import { withBase } from "../utils/slugify";
import HeaderLink from "./HeaderLink.astro";
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';

const site = await getSite();
const [brandArticle, ...brandNameParts] = site.title.trim().split(/\s+/);
const hasBrandArticle = brandArticle?.toLowerCase() === 'the';
const brandName = hasBrandArticle ? brandNameParts.join(' ') : site.title;
import SearchModal from "./SearchModal.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LanguagePicker from "./LanguagePicker.astro";
import { Icon } from "astro-icon/components";

// determine language and translator
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const homeHref = withBase(translatePath('/'));
---

<header class="fixed w-full z-30 flex items-center ">
  <div
    class="content-shell w-full h-full"
  >
    <div
      class="grid h-full grid-cols-[1fr_auto] grid-rows-[auto_auto] items-center xl:grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] xl:grid-rows-1"
    >
      <div class="flex flex-col [html[data-nav='open']_&]:items-center">
        <h1
          class="m-0 text-xs font-semibold uppercase tracking-wide xl:text-base [html[data-nav='open']_&]:text-center"
        >
          <a href={homeHref} aria-label={site.title}>
            {hasBrandArticle ? (
              <>
                <span class="brand-article font-display">{brandArticle}</span>{' '}
                <span>{brandName}</span>
              </>
            ) : (
              <span>{site.title}</span>
            )}
          </a>
        </h1>
      </div>
      <nav
        id="site-navigation"
        class="hidden xl:flex items-center gap-2 xl:gap-3 overflow-x-auto overflow-y-visible pt-1 pb-0.5 text-[0.72rem] tracking-[0.24em] uppercase text-muted [-webkit-overflow-scrolling:touch] [scrollbar-width:none] [--tw-pan-y:none] [&::-webkit-scrollbar]:hidden col-span-2 xl:col-auto xl:justify-self-center [html[data-nav='open']_&]:flex [html[data-nav='open']_&]:flex-col [html[data-nav='open']_&]:items-start [html[data-nav='open']_&]:gap-2 [html[data-nav='open']_&]:py-4 [html[data-nav='open']_&]:w-full [html[data-nav='open']_&]:col-span-2 [html[data-nav='open']_&]:justify-self-stretch"
      >
        <HeaderLink href={translatePath('/menu/')}>
          Menu
        </HeaderLink>
        <HeaderLink href={translatePath('/private-dining/')}>
          {t('nav.privateDining')}
        </HeaderLink>
        <HeaderLink href={translatePath('/journal/') }>
          {t('nav.journal')}
        </HeaderLink>
        <HeaderLink href={translatePath('/story/') }>
          {t('nav.story')}
        </HeaderLink>
        <HeaderLink href={translatePath('/events/') }>
          {t('nav.events')}
        </HeaderLink>
        <HeaderLink href={translatePath('/visit/') }>
          {t('nav.visit')}
        </HeaderLink>
      </nav>
      <div class="flex items-center gap-2 xl:gap-3 shrink-0 justify-end xl:justify-self-end">
        <button
          class="header-button xl:hidden"
          type="button"
          id="nav-toggle"
          aria-controls="site-navigation"
          aria-expanded="false"
          aria-label="Toggle navigation"
          aria-pressed="false"
        >
          <span
            class="inline-flex [html[data-nav='open']_&]:hidden"
            aria-hidden="true"
          >
            <Icon name="tabler:menu-2" size={18} stroke-width={1.6} />
          </span>
          <span
            class="hidden [html[data-nav='open']_&]:inline-flex"
            aria-hidden="true"
          >
            <Icon name="tabler:x" size={18} stroke-width={1.6} />
          </span>
          <span class="sr-only">Toggle navigation</span>
        </button>
        <SearchModal />
        <LanguagePicker />
        <a
          class="header-button hidden xl:inline-flex"
          href="https://github.com/roicort/launchpad"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Visit the GitHub repository"
        >
          <Icon name="tabler:brand-github" size={18} stroke-width={1.6} />
        </a>
        <button
          class="header-button hidden xl:inline-flex"
          type="button"
          id="debug-toggle"
          aria-label="Toggle debug borders"
          aria-pressed="false"
        >
          <Icon name="tabler:bug" size={18} stroke-width={1.6} />
        </button>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<script is:inline>
  const DEBUG_KEY = "debug-borders";

  const applyDebug = (state) => {
    const isOn = state === "on";
    document.documentElement.dataset.debug = isOn ? "on" : "off";
    const button = document.getElementById("debug-toggle");
    if (button) button.setAttribute("aria-pressed", isOn ? "true" : "false");
  };

  const applyNav = (state) => {
    const isOpen = state === "open";
    document.documentElement.dataset.nav = isOpen ? "open" : "closed";
    document.body.classList.toggle("nav-open", isOpen);
    const button = document.getElementById("nav-toggle");
    if (button) {
      button.setAttribute("aria-expanded", isOpen ? "true" : "false");
      button.setAttribute("aria-pressed", isOpen ? "true" : "false");
    }
  };

  const getPreferredDebug = () => {
    const stored = localStorage.getItem(DEBUG_KEY);
    if (stored === "on" || stored === "off") return stored;
    return "off";
  };

  const toggleDebug = () => {
    const current =
      document.documentElement.dataset.debug === "on" ? "on" : "off";
    const next = current === "on" ? "off" : "on";
    localStorage.setItem(DEBUG_KEY, next);
    applyDebug(next);
  };

  const toggleNav = () => {
    const current =
      document.documentElement.dataset.nav === "open" ? "open" : "closed";
    const next = current === "open" ? "closed" : "open";
    applyNav(next);
  };

  applyDebug(getPreferredDebug());
  applyNav("closed");

  const debugButton = document.getElementById("debug-toggle");
  if (debugButton) {
    debugButton.addEventListener("click", toggleDebug);
  }

  const navButton = document.getElementById("nav-toggle");
  if (navButton) {
    navButton.addEventListener("click", toggleNav);
  }

  const navElement = document.querySelector("nav");
  const navLinks = document.querySelectorAll("nav a");
  navLinks.forEach((link) => {
    link.addEventListener("click", () => applyNav("closed"));
  });

  document.addEventListener("click", (event) => {
    if (document.documentElement.dataset.nav !== "open") return;
    const target = event.target;
    if (!(target instanceof Element)) return;
    const clickedToggle = navButton && navButton.contains(target);
    const clickedNav = navElement && navElement.contains(target);
    if (!clickedToggle && !clickedNav) {
      applyNav("closed");
    }
  });
</script>

<style>

  @reference "tailwindcss";

  .brand-article {
	font-size: 1.15em;
	font-weight: 400;
	letter-spacing: 0;
	text-transform: none;
  }

  header {
		min-height: var(--header-height);
		background: color-mix(in oklab, var(--color-surface) 80%, transparent);
		-webkit-backdrop-filter: blur(14px);
		backdrop-filter: blur(14px);
  }

  html[data-nav='open'] header {
	height: 100vh;
	height: 100dvh;
	min-height: 100vh;
	min-height: 100dvh;
	align-items: stretch;
	overflow-y: auto;
	background: var(--color-surface);
  }

  html[data-nav='open'] header .content-shell {
	height: 100%;
	min-height: 100%;
	padding-top: 1rem;
	padding-bottom: 1rem;
  }

  html[data-nav='open'] header .content-shell > .grid {
	min-height: 100%;
	grid-template-columns: minmax(0, 1fr) auto;
	grid-template-rows: auto minmax(0, 1fr);
	align-content: stretch;
  }

  html[data-nav='open'] header h1 {
	font-size: 0.75rem;
  }

  html[data-nav='open'] header .content-shell > .grid > div:first-child {
	grid-row: 1;
	grid-column: 1;
	align-items: flex-start;
  }

  html[data-nav='open'] header nav {
	display: flex;
	grid-row: 2;
	grid-column: 1 / -1;
	flex-direction: column;
	align-items: flex-start;
	align-self: stretch;
	justify-content: center;
	gap: 0.75rem;
	width: 100%;
  }

  html[data-nav='open'] header nav a {
	display: block;
	padding-block: 0.45rem;
	font-size: 0.9rem;
  }

  html[data-nav='open'] header .content-shell > .grid > div:last-child {
	grid-row: 1;
	grid-column: 2;
	align-self: start;
	justify-self: end;
  }

  html[data-nav='open'] header #nav-toggle {
	display: inline-flex;
  }

  html[data-nav='open'] header #debug-toggle,
  html[data-nav='open'] header a[aria-label='Visit the GitHub repository'] {
	display: none;
  }

  :global(body.nav-open) {
	overflow: hidden;
  }

  /* header-button styles moved to `src/styles/global.css` so they apply across components */
</style>
