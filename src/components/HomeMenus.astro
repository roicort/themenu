---
import MenuList from './MenuList.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import { withBase } from '../utils/slugify';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const menus = (await getCollection('menus'))
	.filter((menu) => menu.id.startsWith(`${lang}/`))
	.sort((a, b) => a.data.order - b.data.order);

const copy = {
	en: {
		eyebrow: 'From our kitchen',
		title: 'Explore our menus',
		allMenus: 'View all menus',
		caption: 'On the table',
	},
	fr: {
		eyebrow: 'À notre table',
		title: 'Découvrez nos menus',
		allMenus: 'Voir tous les menus',
		caption: 'Nos cartes',
	},
};

const text = copy[lang];
---

<MenuList
	eyebrow={text.eyebrow}
	title={text.title}
	caption={text.caption}
	allMenusHref={withBase(translatePath('/menu/'))}
	allMenusLabel={text.allMenus}
	items={menus.map((menu) => ({
		title: menu.data.title,
		description: menu.data.description,
		href: withBase(translatePath(`/menu/${menu.data.id}/`)),
	}))}
/>
