---
import { getSite } from '../utils/consts';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslations, useTranslatedPath } from '../i18n/utils';
import { withBase } from '../utils/slugify';

const site = await getSite();
import { Icon } from 'astro-icon/components'

const today = new Date();
const socials = (await getCollection('socials')).map((entry) => entry.data);
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const menus = (await getCollection('menus'))
  .filter((entry) => entry.id.startsWith(`${lang}/`))
  .sort((a, b) => a.data.order - b.data.order);
if (!site.visit) {
  throw new Error('Visit information is missing from site-config.yml.');
}

const visit = site.visit;
const iconMap: Record<string, string> = {
  instagram: 'tabler:brand-instagram',
  facebook: 'tabler:brand-facebook',
  email: 'tabler:mail',
  phone: 'tabler:phone',
};
---

<footer class="border-t border-border bg-surface py-8">
  <div class="content-shell">
    <div class="grid gap-8 border-b border-border pb-10 sm:grid-cols-2 xl:grid-cols-4">
      <section class="space-y-3">
        <h2 class="m-0 text-xl font-semibold tracking-tight text-ink">{t('footer.menus')}</h2>
        <ul class="m-0 grid gap-2 p-0 text-sm text-ink">
          <li>
            <a class="transition-colors hover:text-ink" href={withBase(translatePath('/menu/'))}>
              {t('footer.allMenus')}
            </a>
          </li>
          {menus.map((menu) => (
            <li>
              <a
                class="transition-colors hover:text-ink"
                href={withBase(translatePath(`/menu/${menu.data.id}/`))}
              >
                {menu.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>

      <section class="space-y-3">
        <h2 class="m-0 text-xl font-semibold tracking-tight text-ink">{t('footer.socials')}</h2>
        <div class="grid gap-2 text-sm text-ink">
          {socials.map((social) => {
            const iconName = social.id ? iconMap[social.id.toLowerCase()] : undefined;
            const fallback = social.label?.trim()?.[0]?.toUpperCase() ?? '?';
            return (
              <a
                href={social.href}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'noreferrer' : undefined}
                class="flex items-center gap-2 rounded-md px-2 py-1 transition-colors hover:text-ink hover:bg-[color-mix(in_oklab,var(--color-ink)_3%,transparent)]"
              >
                {iconName ? (
                  <Icon
                    name={iconName}
                    size={18}
                    stroke-width={1.5}
                    class="text-ink"
                    aria-hidden={true}
                  />
                ) : (
                  <span class="inline-flex h-6.5 w-6.5 items-center justify-center rounded-full border border-border text-[0.7rem] font-semibold text-ink" aria-hidden="true">{fallback}</span>
                )}
                <span class="leading-tight">{social.label}</span>
              </a>
            );
          })}
        </div>
      </section>

      <section class="space-y-3">
        <h2 class="m-0 text-xl font-semibold tracking-tight text-ink">{t('footer.address')}</h2>
        <address class="m-0 text-sm not-italic text-muted">{visit.address[lang]}</address>
      </section>

      <section class="space-y-3">
        <h2 class="m-0 text-xl font-semibold tracking-tight text-ink">{t('footer.hours')}</h2>
        <ul class="m-0 grid gap-1 p-0 text-xs text-muted">
          {visit.hours[lang].map((entry) => (
            <li class="flex justify-between gap-2">
              <span>{entry.day}</span>
              <span class="text-right">{entry.schedule}</span>
            </li>
          ))}
        </ul>
      </section>
    </div>
    <div class="grid gap-6 pt-8 md:flex md:items-center md:justify-between">
      <p class="text-sm text-ink m-0"> {site.title} &copy; <a href="https://github.com/roicort/launchpad" class="underline text-muted hover:text-ink">Astro Launchpad</a> {today.getFullYear()}. {t('footer.allRightsReserved')} </p>
      <p class="text-sm text-muted m-0 md:text-right">{t('footer.designedBy')} <a href="https://roicort.github.io" target="_blank" rel="noreferrer" class="underline text-muted hover:text-ink">Rodrigo Cortez</a> {t('footer.inMexicoCity')}</p>
    </div>
  </div>
</footer>
