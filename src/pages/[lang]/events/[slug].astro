---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import EventPost from '../../../layouts/EventPost.astro';
import { defaultLang, showDefaultLang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const pages = await getCollection('events');

  const paths = pages
    .map((page) => {
      const [lang, ...slug] = page.id.split('/');
      return {
        params: { lang, slug: slug.join('/') || undefined },
        props: page,
      };
    })
    .filter(({ params }) => showDefaultLang || params.lang !== defaultLang);

  return paths;
}

type Props = CollectionEntry<'events'>;

const { lang } = Astro.params;
const page = Astro.props as Props;
const formattedDate = page.data.pubDate.toLocaleString(lang);
const { Content } = await render(page);
---

<EventPost {...page.data}>
  <p class="sr-only">{formattedDate}</p>
  <Content />
	</EventPost>
