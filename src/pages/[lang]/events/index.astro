---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';

import { getSite } from '../../../utils/consts';
import { withBase } from '../../../utils/slugify';
import { defaultLang, showDefaultLang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const events = await getCollection('events');
  const langs = Array.from(new Set(events.map((event) => event.id.split('/')[0]))).filter(Boolean);

  return langs
    .filter((lang) => showDefaultLang || lang !== defaultLang)
    .map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang ?? defaultLang;
const events = (await getCollection('events'))
  .filter((event) => event.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const site = await getSite();
---

<PageLayout title={`Events · ${site.title}`} description="Discover upcoming and past events.">
  <section class="content-shell py-12 space-y-10">
    <header class="space-y-2">
      <p class="text-sm uppercase tracking-[0.35em] text-muted">Events</p>
      <h1 class="text-4xl font-semibold text-ink">Upcoming and past events</h1>
      <p class="text-muted max-w-3xl">
        Discover gatherings, experiences, and events hosted by our team.
      </p>
    </header>
    {events.length === 0 ? (
      <p class="text-muted">No events published yet.</p>
    ) : (
      <div class="space-y-6">
        {events.map((event) => {
          const slug = event.id.replace(/^([^/]+)\//, '');
          return (
            <a
              class="group block w-full overflow-hidden rounded-[28px] border border-border bg-surface p-5 shadow-none transition duration-200 hover:-translate-y-0.5 hover:shadow-[0_18px_45px_color-mix(in_oklab,var(--color-ink)_25%,transparent)] md:flex md:items-center md:gap-6"
              href={withBase(`/${lang}/events/${slug}/`)}
            >
              <div class="flex flex-1 flex-col">
                <p class="text-xs font-semibold uppercase tracking-[0.35em] text-muted">Event</p>
                <h3 class="mt-2 text-2xl font-semibold text-ink group-hover:text-ink">{event.data.title}</h3>
                <time class="mt-1 text-xs uppercase tracking-[0.4em] text-muted md:hidden" datetime={event.data.pubDate.toISOString()}>
                  {event.data.pubDate.toLocaleDateString(lang, {
                    day: 'numeric',
                    month: 'short',
                    year: 'numeric',
                  })}
                </time>
                <p class="mt-3 text-lg text-muted">{event.data.description}</p>
                <div class="mt-3 hidden items-center gap-2 text-sm text-muted md:flex">
                  <time datetime={event.data.pubDate.toISOString()}>
                    {event.data.pubDate.toLocaleDateString(lang, {
                      day: 'numeric',
                      month: 'short',
                      year: 'numeric',
                    })}
                  </time>
                </div>
              </div>
              {event.data.heroImage && (
                <figure class="mt-4 h-32 w-full overflow-hidden rounded-[18px] border border-border bg-[color-mix(in_oklab,var(--color-surface)_80%,transparent)] md:mt-0 md:h-24 md:w-32">
                  <Image src={event.data.heroImage} alt={event.data.title} width={220} height={140} class="h-full w-full object-cover" />
                </figure>
              )}
              <time class="sr-only" />
            </a>
          );
        })}
      </div>
    )}
  </section>
</PageLayout>
