---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import JournalPost from '../../layouts/JournalPost.astro';

export async function getStaticPaths() {
	const posts = (await getCollection('journal')).filter((post) => post.id.startsWith('en/'));
	return posts.map((post) => ({
		params: { slug: post.id.replace(/^en\//, '') },
		props: post,
	}));
}
type Props = CollectionEntry<'journal'>;

const post = Astro.props as Props;
const { Content } = await render(post);
---

<JournalPost {...post.data}>
	<Content />
</JournalPost>
