---
import { getCollection } from 'astro:content';
import MenuPage from '../../components/MenuPage.astro';

export async function getStaticPaths() {
	const menus = await getCollection('menus');
	return menus
		.filter((entry) => entry.id.startsWith('en/'))
		.map((entry) => ({
			params: { meal: entry.data.id },
			props: { menuId: entry.data.id },
		}));
}

const { menuId } = Astro.props;
---

<MenuPage lang="en" menuId={menuId} />
